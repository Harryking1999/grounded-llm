# Python 与测试缓存
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 环境与本地工具
.venv/
venv/
node_modules/
.idea/
.vscode/
.codex/cache/

# 密钥与机器本地配置
.env
.env.*
!.env.example
*.pem
*.key
*credential*
*password*

# 临时文件与生成的运行状态
tmp/
.tmp_*/
runs/
logs/
outputs/
wandb/
ray_results/

# 归档的失败实现与本地历史备份
archive/

# 数据集、模型与 checkpoint 不纳入源代码版本控制
data/raw/
data/cache/
data/processed/
models/
checkpoints/
durable/
*.pt
*.pth
*.ckpt
*.distcp
*.safetensors
*.parquet
*.arrow
*.feather
*.npy
*.npz
*.h5
*.hdf5

# 原始逐题回答与结果缓存；正式配置、紧凑摘要和报告图仍跟踪
/experiments/**/results/raw/
/experiments/**/results/cache/
/experiments/**/results/cases.jsonl

# 本地文献调研工作区（初筛笔记、下载论文与临时索引）
literature_review/

# 本地笔记工具缓存
/.obsidian/
/.smart-env/

# 本地代理设置（不依赖开发者个人的全局 Git 忽略配置）
/.claude/settings.local.json

# 地图报告只跟踪正文使用的 PNG；其他导出可由绘图脚本重建
/experiments/cml_map_scaling/results/*.pdf
/experiments/cml_map_scaling/results/*.svg
/experiments/cml_map_scaling/results/geometry.png
