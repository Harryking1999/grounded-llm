  "prompts": {
    "language": "en",
    "system": "You are solving a task on a fixed, undirected, unweighted graph. Follow the requested output format.",
    "user": "Nodes are numbered from 0 to {max_node_id}. One move follows one edge.\nAdjacency list:\n{adjacency}\n{state_block}\n{question}",
