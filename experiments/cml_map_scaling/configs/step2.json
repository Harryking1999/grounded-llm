      "canonical": "Current node: {current_state}\nGoal node: {goal_state}",
      "heldout": "Goal node: {goal_state}\nCurrent node: {current_state}"
    },
    "questions": {
      "canonical": {
        "report_current": "Report the current node. Output only its node ID.",
        "report_goal": "Report the goal node. Output only its node ID.",
        "action": "Choose a next node adjacent to the current node whose shortest-path distance to the goal is strictly smaller. Output only the next node ID."
      },
      "heldout": {
        "report_current": "Which node is the current location? Reply with the node ID only.",
        "report_goal": "Which node is the destination? Reply with the node ID only.",
        "action": "Take one legal step that reduces the minimum number of remaining edges to the destination. Reply with only the node ID reached by that step."
      }
    },
    "adjacency_serialization": "one_line_per_node_ascending_ids_and_neighbors_as_node_colon_space_comma_space_list",
    "graph_visible_in_all_tasks_and_conditions": true,
    "train_and_select_template": "canonical",
    "test_templates": [
      "canonical",
      "heldout"
