{
  "study": "path256_explicit_learned_distance",
  "baseline_config": "experiments/qwen_path_blocks/configs/path256_bidirectional_16k.json",
  "model_id": "Qwen/Qwen3-4B",
  "seed": 20260910,
  "node_count": 256,
  "pair_count": 16,
  "replicates": 8,
  "conditions": {
    "plain": {"enable_thinking": false, "learned_distance": false},
    "reasoning": {"enable_thinking": true, "learned_distance": false},
    "distance": {"enable_thinking": true, "learned_distance": true}
  },
  "step_limit": 256,
  "budget_scope": "per_decision_no_cumulative_token_cap",
  "sampling": {
    "max_new_tokens": 16384,
    "temperature": 0.6,
    "top_p": 0.95,
    "top_k": 20,
    "min_p": 0.0,
    "repetition_penalty": 1.0
  },
  "serving": {
    "dtype": "bfloat16",
    "context_length": 32768,
    "mem_fraction_static": 0.85,
    "max_running_requests": 4
  },
  "concurrency_per_endpoint": 1,
  "timeout_seconds": 7200,
  "seed_rule": "seed + case_index * replicates + replicate_index + step_index * pair_count * replicates",
  "map": {
    "step1_config": "experiments/cml_map_scaling/configs/step1.json",
    "state_dim": 128,
    "seed": 20260910,
    "selection": "fixed_final_epoch_without_planning_score_selection"
  },
  "evaluation": "Original shortest-path judge; no repeated nodes. Same actual feedback and legal candidates for all conditions. Truncated answers fail without resampling."
}
