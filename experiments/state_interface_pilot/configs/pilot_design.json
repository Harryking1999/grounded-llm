{
  "study": "state_interface_pilot",
  "status": "proposed_design_not_runner_compatible",
  "scope": "blocks_report_alignment_to_non_thinking_single_trajectory_planning",
  "model": {
    "id": "Qwen/Qwen3-8B",
    "dtype": "bfloat16",
    "freeze_original_parameters": true,
    "quantization": false,
    "pin_model_and_runtime_revisions_during_implementation": true
  },
  "environment": {
    "reuse_config": "experiments/sol_dag_blocks/configs/sol_medium.json",
    "reuse_fields": ["blocks.grid_size", "blocks.shape_rows", "blocks.shape_subclasses"],
    "reuse_transition": "BlocksTask.apply",
    "goal": "exact_grid_equality",
    "allow_nonempty_goal": true,
    "action_cap": null,
    "minimum_actions_required": false,
    "expose_hidden_construction": false,
    "expose_legal_action_list": false,
    "expose_candidate_transition_queries": false
  },
  "conditions": {
    "T0": {"input": "exact_text_grid", "training": "none"},
    "T1": {
      "input": "exact_text_grid",
      "training": "report_only_fixed_lora",
      "target_modules": ["q_proj", "v_proj"],
      "layers": "all",
      "rank": 2,
      "alpha": 4,
      "dropout": 0.0,
      "inference_state_conditioned_weights": false
    },
    "S": {
      "input": "continuous_row_embeddings",
      "training": "report_only_state_adapter",
      "mlp_dims": [10, 256, 4096],
      "activation": "gelu",
      "bias": true,
      "shared_current_goal_mlp": true,
      "row_embeddings": 10,
      "role_embeddings": 2,
      "tokens_per_state": 10,
      "initial_state_inputs": ["goal", "current"],
      "append_current_after_committed_action": true,
      "repeat_goal_after_each_action": false,
      "give_redundant_exact_text_state": false,
      "initialization": "pytorch_linear_defaults_and_normal_0_0.02_for_row_role_embeddings"
    }
  },
  "data": {
    "seed": 20260913,
    "train_pairs": 2048,
    "development_pairs": 256,
    "pre_alignment_T0_development_episodes": 16,
    "training_construction_counts": [4, 6, 8],
    "training_current": "half_full_initial_board_half_uniform_subset_size_1_to_B_minus_1_then_uniform_subset",
    "empty_goal_fraction": 0.5,
    "training_nonempty_goal": "uniform_subset_size_1_to_current_piece_count_then_uniform_subset",
    "reports_per_pair": ["current", "goal", "current_minus_goal"],
    "split_group": "initial_board_family_including_translation_equivalents_and_descendants",
    "reject_cross_split_identical_current_goal_pairs": true,
    "select_by_model_difficulty": false,
    "planning": {
      "counts": [4, 6, 8, 12],
      "instances_per_count": 32,
      "empty_goals_per_count": 16,
      "nonempty_goal": "retain_between_1_and_B_minus_1_hidden_construction_pieces",
      "samples_per_instance": 1
    },
    "probe_query_counts": {
      "current_report": 16,
      "goal_report": 16,
      "relation_report": 16,
      "single_step_transition": 32,
      "legality": 24,
      "goal_judgment": 24
    }
  },
  "alignment": {
    "format": "non_thinking_chat_report",
    "enable_thinking": false,
    "use_chat_thinking_labels": false,
    "supervise_empty_thinking": false,
    "loss": "original_lm_head_answer_token_cross_entropy",
    "loss_mask": "report_answer_only",
    "task_weights": "equal",
    "normalize_each_example_by_answer_token_count": true,
    "expert_actions_or_cot": false,
    "backpropagate_through_frozen_llm": true,
    "optimizer": "adamw",
    "betas": [0.9, 0.999],
    "eps": 1e-8,
    "weight_decay": 0.0,
    "learning_rates": [0.001, 0.0001],
    "scheduler": "cosine",
    "warmup_ratio": 0.03,
    "gradient_clip_norm": 1.0,
    "effective_batch_size": 32,
    "max_epochs": 3,
    "training_seed": 17,
    "microbatch_policy": "measure_actual_backward_memory_then_use_gradient_accumulation",
    "training_example_max_tokens": 2048,
    "overlength_policy": "fail_preparation_instead_of_truncating",
    "checkpoint_selection": "minimum_development_answer_nll_at_epoch_end_ties_choose_earlier",
    "selection_uses_planning_test": false,
    "generation_format_validation": "non_thinking_report_generation_and_latest_state_readout_in_continuous_sequence"
  },
  "evaluation": {
    "seed": 20260914,
    "enable_thinking": false,
    "temperature": 0.7,
    "top_p": 0.8,
    "top_k": 20,
    "min_p": 0.0,
    "repetition_penalty": 1.0,
    "episode_generated_token_budget": 16384,
    "probe_generated_token_budget": 16384,
    "context_limit": 32768,
    "yarn": false,
    "protocol": "single_assistant_sequence_with_external_state_embedding_insertion",
    "per_segment_max_new_tokens": "min_remaining_episode_budget_and_context_capacity",
    "history": "append_only_previous_states_brief_rationales_and_committed_actions",
    "save_complete_raw_generation": true,
    "rationale_instruction": "one_or_two_sentences_before_committing_one_action",
    "segment_boundary": "one_complete_single_line_json_object_followed_by_newline",
    "rebuild_prefill_each_segment": false,
    "reuse_kv_for_unchanged_prefix": true,
    "rebuild_kv_when_history_changes": true,
    "execute": "advance_planning_state_using_fixed_V_for_the_committed_action_field_only",
    "observe_new_external_state_each_step": false,
    "state_branching_or_rollback": false,
    "automatic_goal_success": true,
    "invalid_action_policy": "fail_without_repair",
    "goal_destruction_policy": "fail_separately_from_physical_illegality",
    "premature_done_policy": "fail",
    "context_overflow_policy": "record_context_cap_without_automatic_history_truncation",
    "output_cap_policy": "fail_no_resample",
    "execute_action_proposals_in_rationale": false,
    "mandatory_state_report_in_planning_output": false,
    "external_selection_or_search": false
  },
  "diagnostics": {
    "state_goal_intervention_pairs": 16,
    "intervention_current_pairs": 8,
    "intervention_goal_pairs": 8,
    "intervention_conditions": ["T0", "T1", "S"],
    "history_ablation_instances": 32,
    "history_ablation_conditions": ["T0", "S"],
    "history_ablation": "latest_state_goal_only",
    "subset_selection": "fixed_balanced_selection_before_model_outputs"
  },
  "analysis": {
    "primary": "paired_episode_success_difference_S_minus_T0",
    "secondary": "paired_episode_success_difference_S_minus_T1",
    "interval": "paired_bootstrap_over_instances",
    "report_strata": ["construction_count", "empty_vs_nonempty_goal"],
    "report_caps_separately_from_known_errors": true,
    "report_actual_training_compute_and_inference_tokens": true,
    "single_seed_claim": "engineering_pilot_only"
  },
  "artifacts": {"directory": "experiments/state_interface_pilot/runs", "git_track_raw_outputs": false}
}
